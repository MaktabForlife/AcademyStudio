+const esc=value=>String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
+export const announcementContact={phone:'27828478639',display:'+27 82 847 8639',email:'admin@ummabbadacademy.com'};
+export function announcementEnrolmentURL(value){if(!value)return '';try{const u=new URL(value);return u.protocol==='https:'&&!u.username&&!u.password&&u.href.length<=2000?u.href:'';}catch{return '';}}
+export const summaryText=row=>String(row.summary||row.message||'').replace(/\[([^\]\n]+)\]\([^\s)]+\)/g,'$1').trim();
+export function announcementStageHTML(row,{preview=false}={}){return `<article class="announcement-feature" aria-label="${esc(row.title)}"><button type="button" class="announcement-feature-art" data-announcement-action="open" aria-label="Open ${esc(row.title)}"${preview?' disabled':''}>${row.imageUrl?'<img src="'+esc(row.imageUrl)+'" alt="'+esc(row.imageAlt||row.title)+'">':'<span class="announcement-art-placeholder" aria-hidden="true">◇</span>'}</button><div class="announcement-feature-copy"><span class="announcement-kicker">From the Academy</span><h3>${esc(row.title)}</h3><p class="announcement-summary">${esc(summaryText(row))}</p><div class="announcement-feature-actions"><button type="button" data-announcement-action="open"${preview?' disabled':''}>Read announcement <span aria-hidden="true">↗</span></button>${announcementEnrolmentURL(row.enrolmentUrl)?'<button type="button" class="announcement-enrol-button" data-announcement-action="enrol"'+(preview?' disabled':'')+'>Enrol now <span aria-hidden="true">↗</span></button>':''}</div></div></article>`;}
+export function announcementDisplay(host,{announcements=[],onOpen=()=>{},preview=false,onSelect=()=>{}}={}){
+ const document=host.ownerDocument;let rows=announcements.slice(0,200),selected=0,closed=false;const prefix='announcement-stage-'+crypto.randomUUID();
+ function draw(){if(closed||!host.isConnected)return;const many=rows.length>1;host.classList.add('announcement-display');host.innerHTML=rows.length?`<div class="announcement-shell${many?' has-index':''}"><div class="announcement-stage" id="${prefix}">${announcementStageHTML(rows[selected],{preview})}</div>${many?'<aside class="announcement-index"><div class="announcement-index-heading"><span>What’s happening</span><span>'+rows.length+' announcements</span></div><nav aria-label="Choose an announcement">'+rows.map((row,index)=>'<button type="button" data-announcement-choice="'+index+'" aria-controls="'+prefix+'" aria-current="'+(index===selected?'true':'false')+'"><span class="announcement-choice-number">'+String(index+1).padStart(2,'0')+'</span><span><strong>'+esc(row.title)+'</strong><span class="announcement-choice-summary">'+esc(summaryText(row))+'</span></span></button>').join('')+'</nav><div class="announcement-pager"><button type="button" data-announcement-action="previous" aria-label="Previous announcement">←</button><span role="status" aria-live="polite">'+(selected+1)+' of '+rows.length+'</span><button type="button" data-announcement-action="next" aria-label="Next announcement">→</button></div></aside>':''}</div>`:'<div class="announcement-empty"><p>No active announcements.</p></div>';
+  for(const image of host.querySelectorAll('img'))image.addEventListener('error',()=>{image.hidden=true;image.parentElement.classList.add('announcement-image-unavailable');});
+ }
+ function select(index,{focus=false}={}){if(!rows.length)return;selected=(index+rows.length)%rows.length;draw();onSelect(rows[selected],selected);if(focus)host.querySelector('[data-announcement-choice="'+selected+'"]')?.focus();}
+ const onClick=event=>{const choice=event.target.closest('[data-announcement-choice]');if(choice){select(Number(choice.dataset.announcementChoice));return;}const action=event.target.closest('[data-announcement-action]')?.dataset.announcementAction;if(action==='previous')select(selected-1);else if(action==='next')select(selected+1);else if(['open','enrol'].includes(action)&&!preview)onOpen(rows[selected],event.target.closest('button'),action);};
+ host.addEventListener('click',onClick);
+ const onKeydown=event=>{if(!event.target.closest('[data-announcement-choice]'))return;let next=selected;if(['ArrowDown','ArrowRight'].includes(event.key))next++;else if(['ArrowUp','ArrowLeft'].includes(event.key))next--;else if(event.key==='Home')next=0;else if(event.key==='End')next=rows.length-1;else return;event.preventDefault();select(next,{focus:true});};
+ host.addEventListener('keydown',onKeydown);
+ draw();return {select,update(next){const id=rows[selected]?.id;rows=next.slice(0,200);selected=Math.max(0,rows.findIndex(row=>row.id===id));draw();},destroy(){closed=true;host.removeEventListener('click',onClick);host.removeEventListener('keydown',onKeydown);host.replaceChildren();},get selected(){return rows[selected];}};
+}
+export function openAnnouncement(document,row,{opener,renderMessage=value=>'<p>'+esc(value).replace(/\n/g,'<br>')+'</p>'}={}){
+ const modal=document.createElement('dialog');modal.className='announcement-reader';const enrol=announcementEnrolmentURL(row.enrolmentUrl),contact=announcementContact;modal.setAttribute('aria-label',row.title);modal.innerHTML=`<header><div><span class="announcement-kicker">Academy announcement</span><h2>${esc(row.title)}</h2></div><button type="button" data-announcement-close aria-label="Close announcement">×</button></header><div class="announcement-reader-body">${row.imageUrl?'<img class="announcement-reader-image" src="'+esc(row.imageUrl)+'" alt="'+esc(row.imageAlt||row.title)+'">':''}<div class="announcement-reader-copy"><p class="announcement-reader-summary">${esc(summaryText(row))}</p>${row.message&&row.message!==row.summary?'<div class="announcement-full-message">'+renderMessage(row.message)+'</div>':''}${row.pdfUrl?'<p><a href="'+esc(row.pdfUrl)+'" target="_blank" rel="noopener noreferrer">Open '+esc(row.pdfName||'announcement PDF')+' ↗</a></p>':''}${enrol?'<p><a class="announcement-enrol-link" href="'+esc(enrol)+'" target="_blank" rel="noopener noreferrer">Open enrolment form ↗</a></p>':''}<aside class="announcement-contact"><h3>Speak to the Academy</h3><p>For programme information and help with enrolment.</p><a href="https://wa.me/${contact.phone}" target="_blank" rel="noopener noreferrer">WhatsApp ${contact.display} ↗</a><a href="mailto:${contact.email}">${contact.email}</a></aside></div></div>`;document.body.append(modal);modal.querySelector('[data-announcement-close]').onclick=()=>modal.close();modal.addEventListener('close',()=>{modal.remove();opener?.focus?.();});modal.addEventListener('click',event=>{if(event.target===modal){const r=modal.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)modal.close();}});modal.showModal();return modal;
+}
