diff --git a/tests/course-card-rework.test.mjs b/tests/course-card-rework.test.mjs
new file mode 100644
index 0000000..85f7bdf
--- /dev/null
+++ b/tests/course-card-rework.test.mjs
@@ -0,0 +1,35 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {parseHTML} from 'linkedom';
+import {circlesCatalogue,selectCatalogueCollection} from '../public/shared/circles-catalogue.mjs';
+import {playlistCardHTML,cardEditorHTML,CARD_DEFAULT} from '../public/shared/playlist-card.mjs';
+import {showLockedAccessNotice,lockedCourseMessage} from '../public/shared/access-badge.mjs';
+const course={kind:'COURSE',key:'synthetic-course',websiteId:'native-site',title:'A checked Course',cover:'/synthetic.png',accent:'#45665a',soft:'#faf7f1'};
+function doc(html){return parseHTML('<html><body>'+html+'</body></html>').document;}
+test('the Course catalogue shows Free, Open or Locked using current native policy and opening rights',()=>{
+ for(const [rights,label]of [[{canOpen:true,coursePolicy:{model:'FREE'}},'Free'],[{canOpen:true,subscriptionStatus:'required',coursePolicy:{model:'PAID'}},'Open'],[{canOpen:false,subscriptionStatus:'subscribed',coursePolicy:{model:'PAID'}},'Locked']]){
+  const root=doc(circlesCatalogue([course],[{websiteId:'native-site',...rights}],{kind:'COURSE'}));assert.equal(root.querySelector('.access-badge').textContent.trim(),label);
+  if(label==='Locked'){assert(root.querySelector('button[data-course-access-locked]'));assert.equal(root.querySelector('a[data-circles-website]'),null);}else assert(root.querySelector('a[data-circles-website="native-site"]'));
+  assert.equal(root.querySelector('[data-circles-tab=TAFSEER]'),null,'Learn → Courses has no Tafseer link');
+ }
+});
+test('entering Courses from Tafseer also removes the Tafseer link without fetching another catalogue',()=>{
+ const root=doc(circlesCatalogue([course],[],{kind:'TAFSEER'}));
+ assert(root.querySelector('[data-circles-tab=TAFSEER]'));
+ selectCatalogueCollection(root,'COURSE');
+ assert.equal(root.querySelector('[data-circles-tab=TAFSEER]'),null);
+ assert.equal(root.querySelector('[data-circles-tab=COURSE]').getAttribute('aria-current'),'page');
+ assert(root.querySelector('[data-circles-section=TAFSEER]').hidden);
+ assert(!root.querySelector('[data-circles-section=COURSE]').hidden);
+ assert(root.querySelector('[data-course-access-locked]'));
+});
+test('shared native playlist cards use the same badge treatment and hold locked clicks away from protected links',()=>{
+ const image={assetId:'a'.repeat(64),sha256:'a'.repeat(64),type:'image/png',size:20,alt:'',url:'/api/public/circles/covers/'+'a'.repeat(64)},row={id:'native-playlist',name:'Shared card',card:{...CARD_DEFAULT,style:'image',image}};
+ for(const kind of ['COURSE','TAFSEER','PROGRAM'])for(const accessLabel of ['Free','Open','Locked']){const root=doc(playlistCardHTML(row,{kind,href:'/studio/?website=native-playlist',websiteId:row.id,accessLabel}));assert(root.querySelector('.has-picture'));assert.equal(root.querySelector('.access-badge').textContent.trim(),accessLabel);assert.equal(Boolean(root.querySelector('[data-course-access-locked]')),accessLabel==='Locked');if(accessLabel==='Locked')assert.equal(root.querySelector('a'),null);}
+});
+test('new playlist card editing offers a private image upload with the standard fixed design',()=>{
+ const root=doc(cardEditorHTML({id:'new-playlist',name:'New playlist',card:CARD_DEFAULT},{kind:'COURSE',imageRequired:true}));assert(root.querySelector('input[type=file][data-card-image]'));assert.equal(root.querySelector('input[type=color],select[data-card-field]'),null);assert.match(root.body.textContent,/standard card design is fixed/);assert.match(root.body.textContent,/private until publication/);assert.match(root.body.textContent,/Required for Course publication/);
+});
+test('a locked card opens the exact purchase-from-Admin notice without a request or content access',()=>{
+ const document=doc('');const create=document.createElement.bind(document);document.createElement=name=>{const el=create(name);if(name==='dialog'){el.showModal=()=>el.setAttribute('open','');el.close=()=>el.removeAttribute('open');}return el;};const notice=showLockedAccessNotice(document);assert.equal(notice.querySelector('p').textContent,lockedCourseMessage);assert(notice.hasAttribute('open'));notice.querySelector('button').click();assert(!notice.hasAttribute('open'));assert.equal(document.querySelectorAll('dialog').length,1);
+});
