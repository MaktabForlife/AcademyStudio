+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {studioFixture} from './studio-access-fixture.mjs';
+import {signIn} from './access-fixture.mjs';
+
+test('the compact Participants commands link existing Core users, grant and revoke Paid access without creating users or staff',async t=>{
+ const z=await studioFixture();t.after(()=>z.f.close());await z.handover();let view=await z.good({action:'read'});
+ if(view.coursePolicy.model!=='PAID'){await z.good({action:'save',revision:view.revision,change:{action:'course-policy',operationId:crypto.randomUUID(),accessModel:'PAID'}});view=await z.good({action:'read'});}
+ const id=z.x.grant,coreBefore=await z.x.db.prepare('SELECT count(*) n FROM accounts').first('n'),staffBefore=(await z.f.db.prepare('SELECT * FROM staff ORDER BY account_id,offering_id').all()).results,operationId=crypto.randomUUID();
+ await z.good({action:'provision',input:{operationId,accountId:id}});await z.good({action:'resume',input:{jobId:operationId}});view=await z.good({action:'read',accountId:id});
+ const grant={action:'save',revision:view.revision,change:{action:'participant',operationId:crypto.randomUUID(),accountId:id,enrolled:true,live:true,purchased:true,cohort:view.person.cohort||'',reason:'Added in Course Participants'}};
+ await z.good(grant);assert((await z.good(grant)).replayed);assert.equal(await z.x.db.prepare('SELECT count(*) n FROM accounts').first('n'),coreBefore);
+ const cookie=await signIn(z.f,'studentB');assert.equal((await z.f.request('/api/websites/site-course',{cookie})).status,200);
+ view=await z.good({action:'read',accountId:id});await z.good({action:'save',revision:view.revision,change:{action:'access-batch',operationId:crypto.randomUUID(),changes:[{action:'participant',accountId:id,enrolled:false,live:false,purchased:false,cohort:view.person.cohort||'',reason:'Course access unchecked in Participants'}]}});
+ assert.equal((await z.f.request('/api/websites/site-course',{cookie})).status,403);assert.deepEqual((await z.f.db.prepare('SELECT * FROM staff ORDER BY account_id,offering_id').all()).results,staffBefore);
+});
+
+test('Course user selection uses current native Core identity and only the permitted Studio-owned Global Admin scope',async t=>{
+ const z=await studioFixture();t.after(()=>z.f.close());
+ assert.equal((await z.proxy({action:'course-user-search',search:''})).status,409,'Legacy ownership must not silently activate Studio');
+ await z.handover();const result=await z.good({action:'course-user-search',search:''});assert.equal(result.schema,'COURSE_USER_SEARCH_V1');assert(result.accounts.some(a=>a.accountId===z.x.student));assert(result.accounts.length<=20);assert(result.accounts.every(a=>a.displayName&&!('pin' in a)&&!('whatsapp' in a)));
+ assert.equal((await z.proxy({action:'course-user-search',search:''},{who:'studentA'})).status,403);
+ assert.equal((await z.proxy({action:'course-user-search',search:''},{who:'adminB'})).status,403);
+ assert.equal((await z.proxy({action:'course-user-search',search:'x'.repeat(81)})).status,400);
+ const token=await z.nativeLogin();await z.x.run('UPDATE account_sessions SET revoked_at=? WHERE account_id=?',new Date().toISOString(),z.f.source.f.actors.global);assert.equal((await z.proxy({action:'course-user-search',search:''})).status,401);assert(token);
+});
+
+test('native Course user search stays bounded after 4,000 then 8,000 unrelated Core accounts and roles',async t=>{
+ const z=await studioFixture();t.after(()=>z.f.close());await z.handover();
+ const add=async prefix=>{await z.x.run("WITH RECURSIVE n(x) AS(VALUES(1) UNION ALL SELECT x+1 FROM n WHERE x<4000) INSERT INTO accounts(account_id,display_name,login_link_id,active) SELECT ?||printf('%05d',x),'Unrelated user',?||printf('%05d',x),1 FROM n",prefix,prefix);await z.x.run("INSERT INTO role_assignments(assignment_id,account_id,activity_key,role,active,review_state) SELECT 'role-'||account_id,account_id,?,'STUDENT',1,'CONFIRMED' FROM accounts WHERE account_id LIKE ?",z.f.source.f.scopes.programB,prefix+'%');};
+ const measure=async()=>{z.f.source.resetMetrics();const result=await z.good({action:'course-user-search',search:'no match'});return {result,metrics:{...z.f.source.metrics},statements:z.f.source.statements.slice()};};
+ await add('zz-a-');await measure();const a=await measure();await add('zz-z-');await measure();const b=await measure();
+ assert.equal(a.result.accounts.length,0);assert.equal(b.result.accounts.length,0);assert(a.result.more&&b.result.more);assert(a.result.nextCursor);assert.equal(b.result.nextCursor,a.result.nextCursor);
+ assert.equal(b.metrics.queries,a.metrics.queries);assert(b.metrics.rowsRead<=a.metrics.rowsRead+4,JSON.stringify({before:a.metrics,after:b.metrics}));
+ t.diagnostic(JSON.stringify({sourceRoot:z.f.source.root,after4000:a.metrics,after8000:b.metrics,emptyResults:true,boundedCandidateKeys:50,localOnly:true}));
+});
