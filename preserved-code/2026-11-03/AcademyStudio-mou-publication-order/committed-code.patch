+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {recordingAttachmentFixture} from './recording-attachment-fixture.mjs';
+import {buildNativeMouPackage} from '../tools/native-mou-attachment-package.mjs';
+import {executeNativeMouPlan,mouPreflightPath,mouOffering} from '../public/shared/native-mou-import.mjs';
+const ok=r=>{assert.equal(r.status,200,JSON.stringify(r.body));return r.body;};
+async function setup(){
+ const f=await recordingAttachmentFixture({attach:false,authorityMode:'ACADEMY',offeringId:mouOffering,cohort:'CLS-39751608-d213-4c66-a4d5-dccfbbeb1c57'});
+ const query=new URLSearchParams();for(const lesson of f.packages.lessons.filter(l=>l.kind==='studio'))query.append('source',new URL(lesson.sourceURL).searchParams.get('v'));
+ const preflight=ok(await f.request('/api/admin/'+f.offer+'/recording-attachments?'+query,{cookie:f.admin}));
+ return {f,plan:buildNativeMouPackage({preflight,...f.packages})};
+}
+test('production authority reproduces the old step4 denial, then resumes exact receipts without granting early publication',async t=>{
+ const {f,plan}=await setup();t.after(()=>f.close());
+ const original=JSON.stringify(plan),first=plan.items[0];
+ for(const step of plan.requests.slice(0,3))ok(await f.request(step.path,{cookie:f.admin,method:'POST',body:step.body}));
+ const failed=await f.request(plan.requests[3].path,{cookie:f.admin,method:'POST',body:plan.requests[3].body});
+ assert.equal(failed.status,403);assert.equal(failed.body.error,'This programme subject is unavailable.');
+ let paused=false;const actions=[];
+ const api=async(path,options={})=>{
+  const action=options.body?.action;
+  if(!paused&&action==='publish'){paused=true;throw Error('Interrupted after private registration');}
+  const response=await f.request(path,{cookie:f.admin,method:options.body?'POST':'GET',body:options.body});
+  const body=ok(response);if(action)actions.push(action);return body;
+ };
+ await assert.rejects(executeNativeMouPlan(plan,{api}),/Interrupted after private/);
+ assert.deepEqual(actions,['website-create','youtube','attachment','mou-subject']);
+ const site=await f.db.prepare('SELECT revision,enabled,published_key FROM websites WHERE website_id=?').bind(first.websiteId).first();
+ assert.deepEqual(site,{revision:0,enabled:0,published_key:null});
+ assert.equal((await f.request('/api/websites/'+first.websiteId,{cookie:f.learner})).status,404);
+ assert.equal((await f.request('/api/media/'+first.attachmentId,{cookie:f.learner})).status,404);
+ assert.equal((await f.request('/api/media/'+first.attachmentId+'/companion',{cookie:f.learner})).status,404);
+ const result=await executeNativeMouPlan(plan,{api});assert.equal(result.completed,4);
+ assert.equal((await executeNativeMouPlan(plan,{api})).completed,4,'Exact completed retries remain safe');
+ assert.equal(JSON.stringify(plan),original,'Do not change the approved package or request bodies/identifiers');
+ assert.equal((await f.db.prepare('SELECT count(*) n FROM programme_subjects WHERE offering_id=?').bind(f.offer).first()).n,5);
+ assert.equal((await f.db.prepare('SELECT count(*) n FROM attachments WHERE website_id=?').bind(f.baqarah.websiteId).first()).n,26);
+ for(const item of plan.items){
+  const feed=ok(await f.request('/api/offerings/'+f.offer+'/media?website='+item.websiteId,{cookie:f.learner}));assert.equal(feed.media.length,1);
+  const companion=ok(await f.request('/api/media/'+item.attachmentId+'/companion',{cookie:f.learner}));assert.equal(companion.quotations.length,0);
+  const textOnly=(await f.login('grant-only')).cookie;await f.run("INSERT INTO website_months VALUES('grant-only',?,'2026-10') ON CONFLICT DO NOTHING",f.offer);
+  assert.equal((await f.request('/api/media/'+item.attachmentId+'/companion',{cookie:textOnly})).status,403);
+ }
+ t.diagnostic(JSON.stringify({authorityMode:'ACADEMY',oldFailureReproduced:true,privateShellDenied:true,completed:4,retryPreserved:true,hostedCalls:0}));
+});
+test('a changed private subject draft blocks the resumed import before any write',async t=>{
+ const {f,plan}=await setup();t.after(()=>f.close());
+ const first=plan.items[0];
+ for(const action of ['website-create','youtube','attachment','mou-subject']){
+  const step=plan.requests.find(r=>r.name.startsWith(first.editorialLessonId+':')&&r.body.action===action);
+  ok(await f.request(step.path,{cookie:f.admin,method:'POST',body:step.body}));
+ }
+ await f.run('UPDATE websites SET revision=1 WHERE website_id=?',first.websiteId);
+ let reads=0,writes=0;const api=async(path,options={})=>{if(options.body)writes++;else reads++;return ok(await f.request(path,{cookie:f.admin,method:options.body?'POST':'GET',body:options.body}));};
+ await assert.rejects(executeNativeMouPlan(plan,{api}),/Preserve the current subject draft/);
+ assert.equal(reads,1);assert.equal(writes,0);assert.equal(mouPreflightPath(plan).startsWith('/api/admin/'+mouOffering+'/recording-attachments?'),true);
+});
