diff --git a/tests/local-assets.test.mjs b/tests/local-assets.test.mjs
new file mode 100644
index 0000000..9087028
--- /dev/null
+++ b/tests/local-assets.test.mjs
@@ -0,0 +1,44 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtemp,mkdir,writeFile,symlink,rm} from 'node:fs/promises';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {localAssets} from '../tools/local-assets.mjs';
+import {fixture} from './fixture.mjs';
+
+test('local assets serve page files, HEAD and missing-file responses without exposing private siblings',async()=>{
+ const root=await mkdtemp(join(tmpdir(),'studio-assets-'));
+ try{
+  const directory=join(root,'public');await mkdir(directory);
+  await writeFile(join(root,'private.json'),'private');
+  await writeFile(join(directory,'index.html'),'<html>Reader</html>');
+  await symlink(join(root,'private.json'),join(directory,'escaped.json'));
+  const assets=localAssets(directory),get=path=>assets(new Request('https://website.test'+path));
+  const page=await get('/?website=one');assert.equal(page.status,200);assert.match(page.headers.get('Content-Type'),/^text\/html/);assert.equal(await page.text(),'<html>Reader</html>');
+  const head=await assets(new Request('https://website.test/',{method:'HEAD'}));assert.equal(head.status,200);assert.equal(await head.text(),'');assert.equal(head.headers.get('Content-Length'),'19');
+  for(const path of ['/missing.mjs','/%2e%2e%2fprivate.json','/escaped.json','/.hidden','/%00','/%zz','/%5cprivate.json'])assert.equal((await get(path)).status,404,path);
+  assert.equal((await assets(new Request('https://website.test/',{method:'POST'}))).status,405);
+ }finally{await rm(root,{recursive:true,force:true});}
+});
+
+test('production Worker fixture serves reader and builder dependency files through ASSETS while keeping APIs gated',async()=>{
+ const f=await fixture({assets:true});
+ try{
+  const queue=['/','/builder/'],seen=new Set();
+  while(queue.length){
+   const path=queue.shift();if(seen.has(path))continue;seen.add(path);
+   const response=await f.runtime.dispatchFetch(f.env.WEBSITE_ORIGIN+path);
+   assert.equal(response.status,200,path);assert.equal(response.headers.get('X-Content-Type-Options'),'nosniff',path);
+   const type=response.headers.get('Content-Type')||'';
+   if(!/text\/|image\/svg/.test(type)){await response.arrayBuffer();continue;}
+   const source=await response.text();
+   if(path==='/')assert.match(source,/<script type="module" src="\/app.mjs"/);
+   const links=type.includes('text/html')?[...source.matchAll(/(?:src|href)="([^"#]+)"/g)].map(m=>m[1]):type.includes('javascript')?[...source.matchAll(/(?:\bfrom\s*|\bimport\s*\(?\s*)['"]([^'"]+)['"]/g)].map(m=>m[1]):type.includes('text/css')?[...source.matchAll(/url\(\s*['"]?([^\s'")]+)['"]?\s*\)/g)].map(m=>m[1]):[];
+   for(const link of links){if(type.includes('javascript')&&!/^(?:\/|\.{1,2}\/)[^\s]+\.mjs$/.test(link))continue;const url=new URL(link,f.env.WEBSITE_ORIGIN+path);if(url.origin===f.env.WEBSITE_ORIGIN)queue.push(url.pathname);}
+  }
+  assert(seen.has('/app.mjs'));assert(seen.has('/shared/recording-companion.css'));assert(seen.has('/shared/model.mjs'));assert(seen.size>35,'Reader/builder dependency graph was checked');
+  assert.equal((await f.request('/api/websites/site-course')).status,401);
+  assert.equal((await f.request('/api/media/private-file')).status,401);
+  assert.equal((await f.runtime.dispatchFetch(f.env.WEBSITE_ORIGIN+'/not-a-page')).status,404);
+ }finally{await f.close();}
+});
