{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "academy-studio-parallel",
  "account_id": "2b01ca929611669e032703ff19f7098f",
  "main": "src/launch-worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./release/v109.17/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "PLATFORM_ENABLED": "1",
    "PARALLEL_ACCESS_ENABLED": "1",
    "ENVIRONMENT": "parallel",
    "AUTHORITY_MODE": "ACADEMY",
    "WEBSITE_ORIGIN": "https://maktab4life.org",
    "ACADEMY_ORIGIN": "https://academy-maktab4life.pages.dev",
    "ACADEMY_API_ORIGIN": "https://devrebootworker.maktab4life.workers.dev",
    "ACCOUNT_MAX_AGE_SECONDS": "43200",
    "LIVE_ACCESS_MAX_AGE_SECONDS": "43200",
    "ADMIN_MAX_AGE_SECONDS": "60",
    "RELEASE_VERSION": "109.17"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "academy-studio-parallel",
      "database_id": "c261eb73-7145-4f73-940c-5816db287612",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "academy-studio-parallel-content"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "academy-studio-parallel-media"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
