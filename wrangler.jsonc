{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maktab-web-platform-local",
  "account_id": "2b01ca929611669e032703ff19f7098f",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/auth/*", "/internal/*"] },
  "vars": {
    "PLATFORM_ENABLED": "0",
    "ENVIRONMENT": "local",
    "WEBSITE_ORIGIN": "https://website.invalid",
    "ACADEMY_ORIGIN": "https://academy.invalid",
    "ACCOUNT_MAX_AGE_SECONDS": "43200",
    "LIVE_ACCESS_MAX_AGE_SECONDS": "43200",
    "ADMIN_MAX_AGE_SECONDS": "300"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "website-platform-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations", "remote": false }],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "website-content-local", "remote": false }, { "binding": "MEDIA", "bucket_name": "website-media-local", "remote": false }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
